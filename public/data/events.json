{
  "_schema": 1,
  "events": [
    {
      "id": "e_gate_trigger",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act1.janganBukaReadEnough", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act1.act2Gate", "value": true } }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act1.act2Gate", "value": true },
        { "type": "advance_act", "act": 2 },
        { "type": "set_flag", "path": "ui.desktopTheme", "value": "dark" },
        { "type": "unlock_chat_thread", "threadId": "chat_darto_gate" },
        {
          "type": "show_notification",
          "payload": {
            "title": "Pak Darto",
            "message": "Mas, jangan naik.",
            "appId": "chat"
          }
        }
      ]
    },
    {
      "id": "e02_log_read",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "act_is", "act": 2 },
          { "type": "flag", "path": "act2.e02LogOpened", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e02LogRead", "value": true } }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e02LogRead", "value": true },
        { "type": "mark_time", "path": "act2.e02LogReadAt" }
      ]
    },
    {
      "id": "e04_rani_authority",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e02LogRead", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e04RaniAuthority", "value": true } },
          {
            "type": "or",
            "conditions": [
              { "type": "flag", "path": "act2.e02ScrollCount", "value": 5 },
              { "type": "flag", "path": "act2.e02ScrollCount", "value": 6 },
              { "type": "flag", "path": "act2.e02ScrollCount", "value": 7 },
              { "type": "flag", "path": "act2.e02ScrollCount", "value": 8 },
              { "type": "flag", "path": "act2.e02ScrollCount", "value": 9 },
              { "type": "flag", "path": "act2.e02ScrollCount", "value": 10 },
              { "type": "flag", "path": "act2.e02ScrollCount", "value": 11 }
            ]
          }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e04RaniAuthority", "value": true },
        { "type": "unlock_chat_thread", "threadId": "chat_rani_authority" },
        {
          "type": "show_notification",
          "payload": {
            "title": "Rani",
            "message": "Kamu buka log ya?",
            "appId": "chat"
          }
        }
      ]
    },
    {
      "id": "e06_cctv_chair",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act1.act2Gate", "value": true },
          { "type": "flag", "path": "act2.cctvOpened", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e06CctvChair", "value": true } }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e06CctvChair", "value": true },
        { "type": "mark_time", "path": "act2.e06CctvChairAt" }
      ]
    },
    {
      "id": "e07_cctv_silhouette",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e06CctvChair", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e07CctvSilhouette", "value": true } }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e07CctvSilhouette", "value": true }
      ]
    },
    {
      "id": "e08_cctv_darto_static",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e06CctvChair", "value": true },
          { "type": "minutes_since", "path": "act2.e06CctvChairAt", "minutes": 3 },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e08CctvDartoStatic", "value": true } }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e08CctvDartoStatic", "value": true }
      ]
    },
    {
      "id": "e09_bagas_contact",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e02LogRead", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e09BagasContact", "value": true } },
          { "type": "time_after", "time": "23:18" },
          { "type": "minutes_since", "path": "act2.e02LogReadAt", "minutes": 8 }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e09BagasContact", "value": true },
        { "type": "mark_time", "path": "act2.e09At" },
        {
          "type": "show_notification",
          "payload": {
            "title": "bagas.p",
            "message": "bagas.p sedang mengetik...",
            "appId": "chat"
          }
        }
      ]
    },
    {
      "id": "e10_bagas_instruction",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e09BagasContact", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e10Instruction", "value": true } },
          { "type": "time_after", "time": "23:30" },
          { "type": "minutes_since", "path": "act2.e09At", "minutes": 8 }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e10Instruction", "value": true },
        {
          "type": "show_notification",
          "payload": {
            "title": "bagas.p",
            "message": "bagas.p sedang mengetik...",
            "appId": "chat"
          }
        }
      ]
    },
    {
      "id": "e15_webcam_seen",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e09BagasContact", "value": true },
          { "type": "flag", "path": "act2.e15WebcamSeen", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e15At" } }
        ]
      },
      "actions": [
        { "type": "mark_time", "path": "act2.e15At" }
      ]
    },
    {
      "id": "e16_remote_stuck",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e15At" },
          { "type": "minutes_since", "path": "act2.e15At", "minutes": 1 },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e16RemoteStuck", "value": true } },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e16RemoteReleased", "value": true } }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e16RemoteStuck", "value": true },
        { "type": "mark_time", "path": "act2.e16At" }
      ]
    },
    {
      "id": "e16_remote_release",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e16RemoteStuck", "value": true },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e16RemoteReleased", "value": true } },
          { "type": "minutes_since", "path": "act2.e16At", "minutes": 6 }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e16RemoteReleased", "value": true }
      ]
    },
    {
      "id": "e17_webcam_shift",
      "once": true,
      "condition": {
        "type": "and",
        "conditions": [
          { "type": "flag", "path": "act2.e16At" },
          { "type": "minutes_since", "path": "act2.e16At", "minutes": 1 },
          { "type": "not", "condition": { "type": "flag", "path": "act2.e17WebcamShift", "value": true } }
        ]
      },
      "actions": [
        { "type": "set_flag", "path": "act2.e17WebcamShift", "value": true }
      ]
    }
  ]
}